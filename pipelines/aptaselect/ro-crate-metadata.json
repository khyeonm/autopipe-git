        {
          "@id": "#input-r1"
        },
        {
          "@id": "#input-r2"
        }
      ],
      "isBasedOn": {
        "@id": "https://hub.autopipe.org/pipelines/115"
      },
      "keywords": [
        "aptamer",
        "SELEX",
        "paired-end",
        "sequence-analysis",
        "enrichment",
        "motif",
        "MEME"
      ],
